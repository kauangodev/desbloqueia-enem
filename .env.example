NEXT_PUBLIC_APP_URL=https://godeveducation.com.br
CAKTO_WEBHOOK_SECRET=
CAKTO_WEBHOOK_ENABLED=false
# Uso local e temporário pelo script scripts/cakto-provision.mjs. Não publicar.
CAKTO_CLIENT_ID=
CAKTO_CLIENT_SECRET=
# OAuth2 token endpoint documented by Cakto; API calls are server-only.
CAKTO_API_BASE_URL=https://api.cakto.com.br/public_api
CHECKOUT_ENABLED=false
# Deprecated compatibility flag; checkout readiness no longer depends on SMTP.
AUTH_EMAIL_READY=false
# Optional branded welcome email. Cakto remains the payment receipt provider;
# the Hostinger runtime sends the secure login link when Resend is configured.
RESEND_API_KEY=
EMAIL_FROM=
CRON_SECRET=
NEXT_PUBLIC_META_PIXEL_ID=
NEXT_PUBLIC_GA_ID=
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5-mini
ACCESS_FINGERPRINT_SALT=
# Server-only secret for the read-only integration health endpoint.
INTEGRATION_HEALTH_SECRET=
# Products, checkout URLs and support are configured through /admin.
# Primary production persistence and authentication runtime on Hostinger/MySQL.
HOSTINGER_MYSQL_HOST=
HOSTINGER_MYSQL_PORT=3306
HOSTINGER_MYSQL_DATABASE=
HOSTINGER_MYSQL_USER=
HOSTINGER_MYSQL_PASSWORD=
# Required in production: generate a dedicated random value with at least 32 characters.
# Never reuse HOSTINGER_MYSQL_PASSWORD or a temporary fallback.
AUTH_SESSION_SECRET=

